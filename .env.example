NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Shared operator gate for /devices, /map, /provisioning, and /api/admin/*.
# Required in production. Leave unset in local development to keep the gate open.
OPERATOR_PASSWORD=
# Zero-Touch / DPC provisioning (Phase 3)
DPC_COMPONENT_NAME=net.sabuycall.mdm/.DeviceAdminReceiver
DPC_APK_URL=https://mdmweb.sabuycall.net/apk/sabuy-mdm.apk
MDM_SERVER_URL=https://mdmweb.sabuycall.net
# Prefer hashing a real APK file or HTTPS download. Local stub for CI/dev:
# DPC_APK_LOCAL_PATH=fixtures/provisioning-apk-stub.bin
# Last-resort override (production should compute from the published APK):
# DPC_APK_CHECKSUM=
