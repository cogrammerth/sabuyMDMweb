NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Operator seed (npm run seed:operator) — creates a confirmed Auth user
OPERATOR_EMAIL=admin@sabuycall.net
OPERATOR_PASSWORD=
# Playwright / local smoke: operator user used by e2e/auth.setup.ts
# The setup job will create this user via the service role if it does not exist.
E2E_OPERATOR_EMAIL=e2e.operator@sabuycall.test
E2E_OPERATOR_PASSWORD=
# Zero-Touch / DPC provisioning (Phase 3)
# Component must match the installed APK package + DeviceAdminReceiver class.
DPC_COMPONENT_NAME=com.sabuycall.sabuymdm/.receiver.SabuyDeviceAdminReceiver
DPC_PACKAGE_NAME=com.sabuycall.sabuymdm
# Optional override. When unset, the hub uses the active app_versions.apk_url
# (Supabase Storage public URL from the App Releases upload).
# DPC_APK_URL=https://YOUR_PROJECT.supabase.co/storage/v1/object/public/dpc-releases/...
MDM_SERVER_URL=https://mdmweb.sabuycall.net
# Prefer extracting SIGNATURE_CHECKSUM from a real signed APK:
# DPC_APK_LOCAL_PATH=path/to/sabuy-dpc.apk
# Last-resort override (URL-safe Base64 SHA-256 of the signing cert, no '='):
# DPC_SIGNATURE_CHECKSUM=
# Legacy alias still accepted as an override only (do NOT put a whole-APK file hash here):
# DPC_APK_CHECKSUM=
# Device API tokens (heartbeat + policy). Soft by default: only devices with a stored hash require X-Device-Token.
# DEVICE_AUTH_REQUIRED=true
# Optional pepper mixed into the SHA-256 hash (rotate requires re-issuing all tokens):
# DEVICE_TOKEN_PEPPER=
